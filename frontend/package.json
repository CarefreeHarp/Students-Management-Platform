{
  "name": "students-management-platform-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Interfaz Angular de StudyFlow",
  "scripts": {
    "start": "npm run prepare-ui && ng serve --host localhost",
    "build": "npm run prepare-ui && ng build",
    "css": "tailwindcss -i ./styles/tailwind.css -o ./public/css/app.css --minify",
    "test:ui": "node --test tests/*.test.cjs",
    "prepare-ui": "npm run css && node scripts/build-sandbox.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.14",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.3"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  }
}
