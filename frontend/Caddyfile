{
	admin off
}

http://:{$PORT:8080} {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy {$BACKEND_URL}
	}

	handle {
		root * /srv
		header /js/* Cache-Control "no-cache"
		header /css/* Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
